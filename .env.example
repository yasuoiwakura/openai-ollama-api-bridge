# ── Bridge ──────────────────────────────────────────────────────
# Health-Check-Anfragen in Logs verbergen (true/false)
HIDE_HEALTHCHECK=false
BRIDGE_HOST=0.0.0.0
# LISTEN_PORT is preferred over BRIDGE_PORT to avoid Kubernetes conflicts
# When a Service named 'bridge' exists, Kubernetes injects BRIDGE_PORT=tcp://...
LISTEN_PORT=8080

# ── Failover ───────────────────────────────────────────────────
# Erster Server (Haupt-Ollama)
OLLAMA_URL=http://192.168.0.42:11434

# Zweiter Server (Failover) – optional
# FAILOVER_OLLAMA_URL=http://192.168.0.101:11434
# FAILOVER_NUM_CTX=96000
# FAILOVER_NUM_PREDICT=128000
# FAILOVER_KEEP_ALIVE=5m
# FAILOVER_TIMEOUT=10

# ── Sampling Defaults ──────────────────────────────────────────
# Werte auskommentiert = Ollama-Standard.
NUM_CTX=32768
KEEP_ALIVE=30m

# ── Client-Overrides ───────────────────────────────────────────
# Erlaubt dem Client, die .env-Overrides pro Request per Header
# "X-Bridge-Override: off" abzuschalten (dann greifen die Modelfile-
# Einstellungen von Ollama). Default: True.
# False = Header wird ignoriert (dem Client das Recht entziehen).
# HEADER_OVERRULES=True
# NUM_PREDICT=128000
# TEMPERATURE=0.7
# TOP_P=0.9
# TOP_K=40
# MIN_P=0.05
# REPEAT_PENALTY=1.1
# FREQUENCY_PENALTY=0.0
# PRESENCE_PENALTY=0.0
# SEED=42
# REPEAT_LAST_N=64
# STOP=["\n\n"]

# ── Queue Mode ─────────────────────────────────────────────────
# Serialisiert mehrere parallele Requests auf 1 parallelen Upstream-Request.
# Aktivierung: X-Bridge-Queue: on (im Header ODER QUEUE_ENABLED=1 in .env)
#
# WICHTIG: API-Keys MÜSSEN über Header kommen (X-Bridge-Target-Key)
# oder über Umgebungsvariablen ({env:...}). NICHT hardcoded in Git!

# ENABLED (Default: 0 = aus, kann per Header X-Bridge-Queue: on aktiviert werden)
# QUEUE_ENABLED=1

# Ziel-URL des Upstream (Optional - kann pro Request per X-Bridge-Target-URL überschrieben)
# QUEUE_TARGET_URL=https://api.cheapestinference.com/v1

# Statischer API-Key (Optional - empfohlen: pro Request per X-Bridge-Target-Key)
# QUEUE_TARGET_KEY=

# Scheduler-Strategie (fifo | group_complete | group_round_robin)
# QUEUE_MODE_DEFAULT=fifo

# Keep-alive Interval an Clients während Queue-Warteschleife (Sekunden)
# QUEUE_KEEPALIVE=15

# Timeouts (Sekunden)
# QUEUE_CONNECT_TIMEOUT=60
# QUEUE_STREAM_TIMEOUT=600

# Maximale Queue-Größe
# QUEUE_MAX_SIZE=500
