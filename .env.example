# ── py-ollama-openai-bridge ────────────────────────────────────────
#
# Hier stellst du ein, wie sich der Proxy gegenüber Ollama verhält.
#
# ALLE Parameter sind auskommentiert – du aktivierst einen Wert
# indem du das `#` am Anfang der Zeile entfernst.
#
# Von Haus aus aktiv:
#   DEFAULT_NUM_CTX      → steuert wie viel Kontext das Modell sieht
#   DEFAULT_NUM_PREDICT  → überschreibt OpenCode's 32K max_tokens
#
# Alle anderen Parameter sind optional und werden NUR gesetzt
# wenn du sie aktivierst. Sonst nutzt Ollama seine eigenen Defaults.
#──────────────────────────────────────────────────────────────────────

#── ERZWUNGENE PARAMETER (immer gesetzt, auch wenn auskommentiert) ──
# Wie viel Kontext (in Tokens) das Modell maximal sehen kann.
# Zu hoch → OOM (Out of Memory). Richtwert für 16GB VRAM: 48000-64000
DEFAULT_NUM_CTX=64000

# Maximale Antwort-Länge in Tokens. Überschreibt OpenCode's 32000.
# Kann ruhig hoch sein (128000) – das Modell stoppt selbst wenn fertig.
# Hoher Wert erlaubt längeres Reasoning / Denkprozesse.
DEFAULT_NUM_PREDICT=128000

#── OPTIONALE SAMPLING-PARAMETER ────────────────────────────────────
# Auskommentiert = nicht setzen → Ollama nutzt seinen Default.

# Kreativität/Zufall. 0 = deterministisch, 1 = kreativ, >1 = chaotisch.
# Ollama-Default: 0.8
#DEFAULT_TEMPERATURE=0.7

# Nucleus Sampling: Anteil der wahrscheinlichsten Tokens die in Frage kommen.
# 1 = alle, 0.5 = nur die Top-50% Wahrscheinlichkeit.
# Ollama-Default: 0.9
#DEFAULT_TOP_P=0.9

# Top-K Sampling: Nur die K wahrscheinlichsten Tokens pro Schritt.
# 0 = deaktiviert. Ollama-Default: 40
#DEFAULT_TOP_K=40

# Minimum Probability: Token muss mindestens diese relative Wahrscheinlichkeit
# zum wahrscheinlichsten Token haben. Moderner als Top-P. 0 = deaktiviert.
# Ollama-Default: 0.0
#DEFAULT_MIN_P=0.05

# Repeat Penalty: Wie stark Wiederholungen bestraft werden.
# 1.0 = keine Strafe, 1.1 = mild, 1.5 = hart.
# Ollama-Default: 1.1
#DEFAULT_REPEAT_PENALTY=1.1

# Frequency Penalty: Bestraft bereits oft genutzte Tokens zusätzlich.
# 0 = keine Strafe, >0 = stärker. Ollama-Default: 0
#DEFAULT_FREQUENCY_PENALTY=0.0

# Presence Penalty: Bestraft Tokens die bereits im Text vorkamen.
# 0 = keine Strafe, >0 = bestraft bekannte Tokens.
# Ollama-Default: 0
#DEFAULT_PRESENCE_PENALTY=0.0

# Seed: Gleicher Seed = gleiche Antwort (bei Temperatur=0).
# 0 = zufällig. Ollama-Default: 0
#DEFAULT_SEED=42

# Repeat Last N: Wie weit zurückgeschaut wird für Repeat Penalty.
# 0 = deaktiviert, -1 = gesamter Kontext. Ollama-Default: 64
#DEFAULT_REPEAT_LAST_N=64

#── SONSTIGE ────────────────────────────────────────────────────────

# Stop-Sequenzen: Bei diesen Strings stoppt die Generierung.
# Komma-getrennte Liste. Ollama-Default: modellabhängig
#DEFAULT_STOP=["\n\n","Human:"]

# Wie lange das Modell nach der Anfrage im Speicher bleibt.
# Ollama-Default: 5m
#DEFAULT_KEEP_ALIVE=30m
